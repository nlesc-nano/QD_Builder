&FORCE_EVAL
  &DFT
    CHARGE 0
    BASIS_SET_FILE_NAME /scratch/iinfante/cp2k_basis/BASIS_MOLOPT_UZH
    POTENTIAL_FILE_NAME /scratch/iinfante/cp2k_basis/POTENTIAL_UZH
    &MGRID
      CUTOFF 400
      NGRIDS 4
    &END
    &POISSON
      POISSON_SOLVER MULTIPOLE
      PERIODIC NONE
    &END
    &QS
      METHOD GPW
    &END
    &SCF
      &OT
        N_DIIS 7
        MINIMIZER DIIS
        PRECONDITIONER FULL_KINETIC
      &END
      EPS_SCF 1.0E-6
      MAX_SCF 200
      SCF_GUESS RESTART
      IGNORE_CONVERGENCE_FAILURE
    &END
    WFN_RESTART_FILE_NAME CdSe-RESTART.wfn
    &XC
      &XC_FUNCTIONAL PBE
      &END
    &END
  &END
  &SUBSYS
    &TOPOLOGY
      COORDINATE XYZ
      COORD_FILE_NAME @XYZ_FILE@
      &CENTER_COORDINATES
      &END
    &END
    &CELL
      ABC @BOX_SIZE@ @BOX_SIZE@ @BOX_SIZE@
      PERIODIC NONE
    &END
    &KIND Cd
      BASIS_SET DZVP-MOLOPT-GGA-GTH-q12
      POTENTIAL GTH-GGA-q12
    &END
    &KIND Se
      BASIS_SET DZVP-MOLOPT-GGA-GTH-q6
      POTENTIAL GTH-GGA-q6
    &END
    &KIND Cl
      BASIS_SET DZVP-MOLOPT-GGA-GTH-q7
      POTENTIAL GTH-GGA-q7
    &END
  &END
&END

&GLOBAL
  PRINT_LEVEL LOW
  PROJECT CdSe
  RUN_TYPE GEO_OPT
&END
