&FORCE_EVAL
  &DFT
    CHARGE 0
    BASIS_SET_FILE_NAME /scratch/iinfante/cp2k_basis/BASIS_MOLOPT_UZH
    POTENTIAL_FILE_NAME /scratch/iinfante/cp2k_basis/POTENTIAL_UZH
    &MGRID
      CUTOFF 400
      NGRIDS 4
    &END
    &POISSON
      POISSON_SOLVER MULTIPOLE
      PERIODIC None
    &END
    &QS
      METHOD gpw
    &END
    &SCF
      &OT
        N_DIIS 7
        MINIMIZER DIIS
        PRECONDITIONER FULL_KINETIC
      &END
      EPS_SCF 1e-6
      MAX_SCF 100
      SCF_GUESS atomic
      IGNORE_CONVERGENCE_FAILURE
    &END
    &XC
      &XC_FUNCTIONAL PBE
      &END
    &END
  &END
  &SUBSYS
    &TOPOLOGY
      COORDINATE XYZ
      COORD_FILE_NAME __XYZ_FILE__
      &CENTER_COORDINATES
      &END
    &END
    &CELL
      ABC __ABC_SIZE__
      PERIODIC None
    &END
    &KIND Cd 
      BASIS_SET DZVP-MOLOPT-GGA-GTH-q12
      POTENTIAL GTH-GGA-q12
    &END
    &KIND Se
      BASIS_SET DZVP-MOLOPT-GGA-GTH-q6
      POTENTIAL GTH-GGA-q6
    &END
    &KIND Cl
      BASIS_SET DZVP-MOLOPT-GGA-GTH-q7
      POTENTIAL GTH-GGA-q7
    &END
  &END
&END

&GLOBAL
  PRINT_LEVEL low
  PROJECT __PREFIX__
  RUN_TYPE GEO_OPT
&END

&MOTION
  &GEO_OPT
     MAX_ITER 100 
  &END
&END 
